# --- Core ---
PORT=5001
WS_PORT=8081
MONGODB_URI=
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# --- Realtime security (required in production) ---
# Signs session resume tokens. Without it a random per-process secret is used (dev only).
WS_TOKEN_SECRET=
# Enables GET /api/metrics with "Authorization: Bearer <token>". Endpoint is disabled when unset.
METRICS_TOKEN=

# --- Auth ---
# Signs access tokens. Required in production.
JWT_SECRET=
# false (default) keeps REST routes open for the current client; true requires a Bearer token + role.
AUTH_ENFORCED=false
# Backfill owners on existing interviews: BACKFILL_OWNER_EMAIL=... node scripts/backfill-interview-owner.js [--dry-run]
# Create the first admin: ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/create-admin.js
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=1209600
# BCRYPT_COST=12
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MS=900000

# --- Google Cloud (service account JSON on one line) ---
GCP_CREDENTIALS_JSON=
# Vertex AI LLM. Set VERTEX_MODEL for serverless Gemini (pay per token, nothing to deploy),
# or VERTEX_ENDPOINT_ID for a self-deployed dedicated endpoint. VERTEX_MODEL wins if both are set.
VERTEX_PROJECT_NUMBER=
VERTEX_MODEL=
VERTEX_ENDPOINT_ID=
VERTEX_LOCATION=us-central1
# Reply length cap. Thinking-capable Gemini models count reasoning tokens toward it, so raise this if replies come back empty.
# LLM_MAX_TOKENS=50

# --- Interview engine (defaults shown) ---
# "freeform" restores the legacy prompt-only interviewer (rollback switch).
# INTERVIEW_ENGINE=structured
# INTERVIEW_MAX_QUESTIONS=5          # main questions per interview (the introduction is not counted)
# INTERVIEW_MAX_FOLLOWUPS=2          # follow-ups per main question
# INTERVIEW_MAX_CLARIFICATIONS=1
# INTERVIEW_MAX_REPEATS=2
# INTERVIEW_HISTORY_WINDOW=6         # recent messages sent to the model (plus a rolling summary)
# INTERVIEW_ANALYSIS_MAX_TOKENS=1000 # evaluation + decision call
# INTERVIEW_QUESTION_MAX_TOKENS=500
# INTERVIEW_ASSIST_MAX_TOKENS=200    # hints and "explain the question"
# INTERVIEW_BARGE_IN=false           # false: mic is muted while the AI speaks (strict turn-taking); true: candidate may interrupt
# INTERVIEW_PLAYBACK_ACK_TIMEOUT_MS=30000  # floor returns to the candidate if the client never reports playback finished
# INTERVIEW_TOPIC_OVERRUN_FACTOR=1.5   # template interviews: a topic that used this multiple of its allocated time is moved past

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- Tunables (defaults shown) ---
# End-of-turn strategy
# EOT_SPEECH_FINAL_GRACE_MS=1200
# EOT_UTTERANCE_END_GRACE_MS=0
# EOT_FALLBACK_MS=3000
# EOT_MANUAL_STOP_WAIT_MS=600
# DEEPGRAM_ENDPOINTING_MS=500
# DEEPGRAM_UTTERANCE_END_MS=1000
# Provider timeouts / retries
# LLM_TIMEOUT_MS=15000
# LLM_RETRIES=1
# TTS_TIMEOUT_MS=10000
# TTS_RETRIES=1
# TURN_DEADLINE_MS=30000
# Sessions / transport
# SESSION_TTL_MS=900000
# WS_RECOVERY_WINDOW_MS=120000
# WS_MAX_PAYLOAD_BYTES=131072
# WS_MAX_TEXT_CHARS=4000
# WS_MSG_RATE_MAX=40
# WS_MSG_RATE_WINDOW_MS=10000
# LOG_LEVEL=info
