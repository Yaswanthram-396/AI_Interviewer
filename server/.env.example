# --- Core ---
PORT=5001
WS_PORT=8081
MONGODB_URI=
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# --- Realtime security (required in production) ---
# Signs session resume tokens. Without it a random per-process secret is used (dev only).
WS_TOKEN_SECRET=
# Enables GET /api/metrics with "Authorization: Bearer <token>". Endpoint is disabled when unset.
METRICS_TOKEN=

# --- Google Cloud (service account JSON on one line) ---
GCP_CREDENTIALS_JSON=
# Vertex AI dedicated endpoint (previously hardcoded in index.js; now required)
VERTEX_PROJECT_NUMBER=
VERTEX_ENDPOINT_ID=
VERTEX_LOCATION=us-central1

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- Tunables (defaults shown) ---
# End-of-turn strategy
# EOT_SPEECH_FINAL_GRACE_MS=1200
# EOT_UTTERANCE_END_GRACE_MS=0
# EOT_FALLBACK_MS=3000
# EOT_MANUAL_STOP_WAIT_MS=600
# DEEPGRAM_ENDPOINTING_MS=500
# DEEPGRAM_UTTERANCE_END_MS=1000
# Provider timeouts / retries
# LLM_TIMEOUT_MS=15000
# LLM_RETRIES=1
# TTS_TIMEOUT_MS=10000
# TTS_RETRIES=1
# TURN_DEADLINE_MS=30000
# Sessions / transport
# SESSION_TTL_MS=900000
# WS_RECOVERY_WINDOW_MS=120000
# WS_MAX_PAYLOAD_BYTES=131072
# WS_MAX_TEXT_CHARS=4000
# WS_MAX_QUEUED_TURNS=3
# WS_MSG_RATE_MAX=40
# WS_MSG_RATE_WINDOW_MS=10000
# LOG_LEVEL=info
